# Local dev: copy to .env.local.  VPS (Docker): copy to .env next to compose.yaml.
# Both are git-ignored and docker-ignored; never commit the real values.

# From https://stashdb.org -> your profile -> API key. Only the scraper uses it.
STASHDB_API_KEY=

# VPS only: Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels -> your
# tunnel -> the long token after "--token"). Only the cloudflared container sees it.
TUNNEL_TOKEN=

# Optional
# PORT=3000                        # host port the app binds on 127.0.0.1
# STASHDB_ENDPOINT=https://stashdb.org/graphql
# STASHDB_MIN_INTERVAL_MS=1000     # politeness delay between requests
# STASHDB_PER_PAGE=100
# STASHDB_TAG_IDS=id1,id2          # skip tag discovery and use exactly these
# DATABASE_PATH=./data/family.db   # local dev only; the container uses /data
